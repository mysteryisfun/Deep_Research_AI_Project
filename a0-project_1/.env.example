# Supabase Configuration
# Copy this file to .env.local and update the values for your environment
SUPABASE_URL=https://your-project-url.supabase.co
SUPABASE_ANON_KEY=your-anon-key-goes-here

# Webhook Configuration
# This URL is used for sending data when a research answer is submitted
N8N_WEBHOOK_URL=https://your-webhook-url-goes-here

# ===== INSTRUCTIONS =====
# 1. Copy this file to one of the following (in order of precedence):
#    - .env.development.local (for development-specific overrides, git-ignored)
#    - .env.local (for local overrides, git-ignored)
#    - .env.development (for development defaults, can be committed)
#    - .env (for defaults, can be committed)
#
# 2. Replace the placeholder values with your actual credentials
#
# 3. DO NOT commit files containing actual credentials to git
#    (ensure .env.local and .env.*.local are in your .gitignore)
#
# Note: The app will first check environment variables in app.config.js,
# then in app.json's extra section, and finally in process.env. 