{
  "expo": {
    "name": "Royal Research",
    "slug": "royal-research",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/splash-icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.royalresearch.app",
      "buildNumber": "1.0.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.royalresearch.app",
      "versionCode": 1,
      "permissions": ["NOTIFICATIONS"]
    },
    "web": {
      "favicon": "./assets/splash-icon.png",
      "bundler": "metro",
      "build": {
        "babel": {
          "include": []
        }
      }
    },
    "plugins": [
      "expo-image-picker",
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/splash-icon.png",
          "color": "#4A00E0"
        }
      ]
    ],
    "sdkVersion": "52.0.0",
    "extra": {
      "eas": {
        "projectId": "your-project-id-here"
      }
    }
  }
}